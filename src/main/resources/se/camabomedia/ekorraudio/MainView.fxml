<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.camabomedia.ekorraudio.ui.MainViewController">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="Arkiv">
          <items>
            <MenuItem fx:id="menuItemOpen" mnemonicParsing="false" onAction="#handleMenuItemOpen" text="Öppna…" accelerator="Shortcut+O" />
            <Menu fx:id="menuRecent" mnemonicParsing="false" text="Öppna senaste" />
            <MenuItem mnemonicParsing="false" onAction="#handleMenuItemClose" text="Stäng boken" accelerator="Shortcut+W" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" onAction="#handleMenuItemShowReport" text="Se rapport" accelerator="Shortcut+R" />
            <MenuItem mnemonicParsing="false" onAction="#handleMenuItemOpenReportFolder" text="Öppna rapportmappen" Accelerator="Shortcut+Shift+R" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" onAction="#handleMenuItemQuit" text="Avsluta" accelerator="Shortcut+Q" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Kommentarer">
          <items>
            <MenuItem mnemonicParsing="false" text="Skapa kommentar (Enter)" />
            <MenuItem mnemonicParsing="false" text="Redigera kommenter (dubbelklick)" />
            <MenuItem mnemonicParsing="false" text="Ta bort kommentar (Delete)" />
          </items>
        </Menu>
        <Menu fx:id="menuNavigation" mnemonicParsing="false" text="Navigering" />
        <Menu mnemonicParsing="false" text="Anpassning">
          <items>
            <MenuItem mnemonicParsing="false" onAction="#handleMenuItemFont" text="Typsnitt …" />
            <Menu fx:id="menuTheme" mnemonicParsing="false" text="Tema" />
            <Menu fx:id="menuWaveform" mnemonicParsing="false" text="Ljudkurvans läge" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <CheckMenuItem fx:id="menuItemShowWaveform" mnemonicParsing="false" text="Visa ljudkurvan" />
            <CheckMenuItem fx:id="menuItemShowLeft" mnemonicParsing="false" text="Visa vänsterkolumnen" />
            <CheckMenuItem fx:id="menuItemShowRight" mnemonicParsing="false" text="Visa högerkolumnen" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Inställningar">
          <items>
            <MenuItem fx:id="menuItemName" mnemonicParsing="false" onAction="#handleMenuItemName" text="Namn..." />
            <MenuItem fx:id="menuItemLocations" mnemonicParsing="false" onAction="#handleMenuItemLocations" text="Mappar..." />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Hjälp">
          <items>
            <MenuItem fx:id="menuItemManual" mnemonicParsing="false" onAction="#handleMenuItemManual" text="Manual" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
    <!-- Verktygsraden byggs i MainViewController.buildToolbar() -->
    <HBox fx:id="toolbar" />
    <SplitPane fx:id="splitPane" blendMode="SRC_ATOP" dividerPositions="0.15, 0.85" focusTraversable="true" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
      <items>
        <AnchorPane fx:id="commentPane" />
        <AnchorPane fx:id="contentPane" />
        <AnchorPane fx:id="nccPane" />
      </items>
    </SplitPane>
    <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0" VBox.vgrow="NEVER">
      <children>
        <Label fx:id="labelStatus" maxHeight="1.7976931348623157E308" maxWidth="-1.0" text="" HBox.hgrow="ALWAYS">
          <font>
            <Font size="11.0" fx:id="x3" />
          </font>
          <textFill>
            <Color red="0.625" green="0.625" blue="0.625" fx:id="x4" />
          </textFill>
        </Label>
        <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <Label font="$x3" maxWidth="-1.0" text="" textFill="$x4" HBox.hgrow="NEVER" />
      </children>
      <padding>
        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
    </HBox>
  </children>
</VBox>

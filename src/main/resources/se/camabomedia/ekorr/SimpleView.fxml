<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se.camabomedia.ekorr.SimpleViewController">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="Arkiv">
          <items>
            <MenuItem fx:id="menuItemOpen" mnemonicParsing="false" onAction="#handleMenuItemOpen" text="Öppna…" />
            <Menu fx:id="menuOpenRecent" mnemonicParsing="false" onAction="#handleMenuOpenRecent" text="Öppna senaste..." />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem fx:id="menuItemQuit" mnemonicParsing="false" onAction="#handleMenuItemQuit" text="Avsluta" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Redigera">
          <items>
            <MenuItem fx:id="menuItemCreateComment" mnemonicParsing="false" onAction="#handleMenuItemCreateComment" text="Skapa kommentar" />
            <MenuItem fx:id="menuItemEditComment" mnemonicParsing="false" onAction="#handleMenuItemEditComment" text="Redigera kommentar" />
            <MenuItem fx:id="menuItemRemoveComment" mnemonicParsing="false" onAction="#handleMenuItemRemoveComment" text="Ta bort kommentar" />
          </items>
        </Menu>
            <Menu mnemonicParsing="false" text="Inställningar">
              <items>
                <MenuItem fx:id="menuItemName" mnemonicParsing="false" onAction="#handleMenuItemName" text="Namn" />
                  <MenuItem fx:id="menuItemTalkingBooks" mnemonicParsing="false" onAction="#handleMenuItemTalkingBooks" text="Mapp för talböcker" />
                  <MenuItem fx:id="menuItemReports" mnemonicParsing="false" onAction="#handleMenuItemReports" text="Mapp för rapporter" />
              </items>
            </Menu>
        <Menu mnemonicParsing="false" text="Hjälp">
          <items>
            <MenuItem fx:id="menuItemManual" mnemonicParsing="false" onAction="#handleMenuItemManual" text="Läs manual" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
      <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="tableColumnNr" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" text="Nr" />
          <TableColumn fx:id="tableColumnPage" editable="false" maxWidth="65.0" minWidth="65.0" prefWidth="65.0" resizable="false" sortable="false" text="Sida" />
            <TableColumn fx:id="tableColumnType" editable="false" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" resizable="false" sortable="false" text="Typ" />
            <TableColumn fx:id="tableColumnComment" editable="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="560.0" resizable="false" sortable="false" text="Kontext                                                                                                                                                 " />
        </columns>
         <VBox.margin>
            <Insets left="4.0" right="4.0" />
         </VBox.margin>
      </TableView>
      <HBox>
         <VBox.margin>
            <Insets right="12.0" top="4.0" />
         </VBox.margin>
         <children>
            <ButtonBar nodeOrientation="RIGHT_TO_LEFT" prefHeight="40.0">
              <buttons>
                  <Button fx:id="btnOpenReportDirectory" focusTraversable="false" mnemonicParsing="false" onAction="#handleBtnOpenReportDirectory" text="Rapportmapp" />
                <Button fx:id="btnViewReport" focusTraversable="false" mnemonicParsing="false" onAction="#handleBtnViewReport" text="Se rapport" />
              </buttons>
               <HBox.margin>
                  <Insets left="12.0" />
               </HBox.margin>
            </ButtonBar>
            <ButtonBar nodeOrientation="LEFT_TO_RIGHT" prefHeight="40.0" HBox.hgrow="ALWAYS">
              <buttons>
                  <Button fx:id="btnCreate" focusTraversable="false" mnemonicParsing="false" onAction="#handleBtnCreate" text="Skapa" />
                <Button fx:id="btnEdit" focusTraversable="false" mnemonicParsing="false" onAction="#handleBtnEdit" text="Redigera" />
                  <Button fx:id="btnRemove" focusTraversable="false" mnemonicParsing="false" onAction="#handleBtnRemove" text="Ta bort" />
                  <Button fx:id="btnQuit" focusTraversable="false" mnemonicParsing="false" onAction="#handleBtnQuit" text="Avsluta" />
              </buttons>
            </ButtonBar>
         </children>
      </HBox>
    <HBox id="HBox" alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="25.0" spacing="5.0" VBox.vgrow="NEVER">
      <children>
        <Label maxHeight="1.7976931348623157E308" maxWidth="-1.0" text="Antal kommentarer: " HBox.hgrow="ALWAYS">
          <font>
            <Font size="11.0" fx:id="x3" />
          </font>
          <textFill>
            <Color red="0.625" green="0.625" blue="0.625" fx:id="x4" />
          </textFill>
        </Label>
        <Pane fx:id="titlePane" prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <Label font="$x3" maxWidth="-1.0" text="Right status" textFill="$x4" HBox.hgrow="NEVER" />
      </children>
      <padding>
        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
    </HBox>
  </children>
</VBox>
